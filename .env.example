# Configuración de Supabase
# Copia este archivo como ".env" y reemplaza los valores por tus credenciales de Supabase

# URL de tu proyecto Supabase 
VITE_SUPABASE_URL=TU_SUPABASE_URL_AQUI

# Clave pública anónima de tu proyecto Supabase 
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY_AQUI

# Número de WhatsApp para contacto
VITE_WHATSAPP_NUMBER=TU_NUMERO_WHATSAPP_AQUI

